# Copy this file to .env (already gitignored) and fill in real values.
# .env is loaded automatically by src/ui/app.py on startup.

# Switches the chat/embedding backend from the default local Foundry Local
# runtime to Google's Gemini API (free tier). This is a deliberate,
# opt-in departure from the project's local/offline-first default — see
# CLAUDE.md. Leave unset (or "foundry_local") to keep everything local.
# LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=gemini. Get a free key at
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Note: "attach a photo/PDF to add an event" in the assistant chat only
# appears when LLM_PROVIDER=gemini is active — the local Foundry Local
# model doesn't support file input (see FileInputCapable in
# src/providers/base.py).

# Same LLM_PROVIDER=gemini dependency applies to scanning photo/PDF
# attachments on incoming mail (see mail_analysis.py::
# extract_candidate_from_email_with_attachments) — with the default
# Foundry Local backend, only the mail's text body is ever scanned.

# Required for Outlook/Microsoft account support (src/connectors/microsoft_auth.py).
# The Application (client) ID from an Azure App Registration created under
# a PERSONAL Microsoft account (not a work/school one — most organizational
# tenants disable self-service app registration for regular users). Set
# supported account types to "Personal Microsoft accounts only", add a
# "Mobile and desktop applications" platform with redirect URI
# http://localhost, and grant delegated Microsoft Graph permissions:
# Mail.Read, Calendars.ReadWrite, offline_access, User.Read. No client
# secret needed (public client). See CLAUDE.md's Outlook section for the
# full walkthrough.
# MS_CLIENT_ID=

# By default, mail body/chat text/raw LLM input-output written to
# data/debug.log is truncated + hashed (see src/core/logging_config.py::redact)
# instead of appearing in full — that file is unencrypted. Set LOG_CONTENT=full
# to see raw content while actively debugging locally. Never set this on a
# shared/server deployment.
# LOG_CONTENT=full

# Encrypts OAuth token files at rest (data/google_token_*.json,
# data/ms_token_*.json) — see src/core/token_crypto.py (PRIV-01). Optional
# for local development (tokens stay plaintext if unset, same as before);
# REQUIRED on any server deployment. Generate one with:
#   python -m src.core.token_crypto
# Store this value only in the server's environment — never in the data/
# directory itself (a stolen data/ backup must not also carry the key).
# TOKEN_ENCRYPTION_KEY=

# Adds the Secure flag to every cookie the app sets (session, OAuth state,
# active account/language/theme, chat session) — see src/ui/session.py::
# cookie_secure (AUTH-03). Leave unset for local http://localhost
# development (a Secure cookie is never sent over plain HTTP, so setting
# this locally would break login). Set to "true" ONLY once HTTPS is
# genuinely terminating end-to-end in front of the app on a real server.
# COOKIE_SECURE=true

# --- Docker / VPS (bkz. docker-compose.yml) ---
# Caddy'nin sertifika alacağı alan adı (compose için ZORUNLU).
# DOMAIN=asistan.example.com
# Outlook redirect URI'si; VPS'te Azure'a kayıtlı https adresi. Yerelde boş bırak
# (varsayılan http://localhost:8000/hesap-ekle-outlook/callback).
# MS_REDIRECT_URI=https://asistan.example.com/hesap-ekle-outlook/callback
# Konteyner dışında sunucuyu başka bir adreste dinletmek için (varsayılan 127.0.0.1:8000):
# HOST=0.0.0.0
# PORT=8000
